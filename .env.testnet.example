# BSC testnet only. Copy values into an untracked environment or secret store.
# Never use mainnet RPC URLs, production TES, or production keys with this harness.
BSC_TESTNET_RPC_URL=

# Existing tes-crowdfund V2 deployment inputs. Deploy MockTES on testnet by leaving
# TOKEN_ADDRESS empty when running the guarded V2 deploy script.
TOKEN_ADDRESS=
ARBITRATOR_ADDRESS=

# Test-only transaction signers. Use independently generated testnet wallets holding
# only test BNB/MockTES. Values are never written to the harness state file.
DEPLOYER_PRIVATE_KEY=
TESTNET_CREATOR_PRIVATE_KEY=
TESTNET_ARBITRATOR_PRIVATE_KEY=
TESTNET_BACKER_A_PRIVATE_KEY=
TESTNET_BACKER_B_PRIVATE_KEY=
TESTNET_OUTSIDER_PRIVATE_KEY=

# Harness operation. Valid phases are seed, funding-expiry, review-1, review-2,
# arbitration-timeout, creator-inactivity, and verify-all.
TESTNET_HARNESS_PHASE=verify-all
TESTNET_HARNESS_STATE=.testnet-runs/bsc-testnet-v2.json
TESTNET_CONFIRMATIONS=3
TESTNET_RELEASE_COMMIT=

# Production-like backend publication verification. The operator credential is
# exchanged for a short-lived session and remains process-only.
TESTNET_BACKEND_URL=
TESTNET_OPERATOR_CREDENTIAL=
