{
  "name": "tesla-crowdfund",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "preflight": "node scripts/preflight.mjs",
    "test:contracts": "hardhat test",
    "build:frontend": "bash -c \"cd frontend && npm ci && npm run build\"",
    "deploy:testnet": "npm run preflight && hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:mainnet": "npm run preflight && node scripts/requireMainnetConfirm.mjs && hardhat run scripts/deploy.ts --network bscMainnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network bscMainnet",
    "smoke:testnet": "hardhat run scripts/smoke.ts --network bscTestnet",
    "smoke:mainnet": "hardhat run scripts/smoke.ts --network bscMainnet"
  },
  "keywords": [],
