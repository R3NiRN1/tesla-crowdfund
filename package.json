  "description": "",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@types/node": "^25.0.3",
    "dotenv": "^17.2.3",
    "ethers": "^5.8.0",
    "hardhat": "^2.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  }
}
