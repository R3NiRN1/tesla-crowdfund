# Hardhat (root)
BSC_TESTNET_RPC_URL=
BSC_MAINNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=
BSCSCAN_API_KEY= # BscScan API key for V2 source verification
CONFIRM_MAINNET= # Set to YES for guarded mainnet deploys; this is necessary but never sufficient for release approval

# V2 deployment inputs.
# TOKEN_ADDRESS may be left empty on non-mainnet networks to deploy MockTES.
# Mainnet requires an explicitly verified external token address.
TOKEN_ADDRESS=
# Required for every CampaignFactoryV2 deployment. Never defaults to the deployer.
ARBITRATOR_ADDRESS=

# Backend alpha. Production readiness is still blocked on durable storage/operator hardening.
BACKEND_PORT=8787
ADMIN_TOKEN=
CORS_ORIGIN=http://localhost:3000
# Empty by default: X-Forwarded-For is ignored unless the TCP peer is explicitly listed here.
# Use exact proxy IPv4/IPv6 addresses only; comma-separate multiple trusted proxies.
TRUSTED_PROXY_IPS=

# Independent backend publication verification.
# These are server-side trust anchors; do not derive them from browser-submitted values.
BACKEND_RPC_URL=https://bsc-testnet.publicnode.com
BACKEND_CHAIN_ID=97
BACKEND_FACTORY_V2_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_ARBITRATOR_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_PUBLISH_CONFIRMATIONS=3

# Frontend (copy the applicable values to frontend/.env.local).
# Use ZERO_ADDRESS placeholders to keep the app in setup/read-only mode.

# [BSC TESTNET (97)]
NEXT_PUBLIC_RPC_URL=https://bsc-testnet.publicnode.com
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BSCSCAN_BASE=https://testnet.bscscan.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_WC_ENABLED=false
NEXT_PUBLIC_WC_PROJECT_ID=

# [BSC MAINNET (56)]
# NEXT_PUBLIC_RPC_URL=https://bsc-dataseed.binance.org
# NEXT_PUBLIC_CHAIN_ID=56
# NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_BSCSCAN_BASE=https://bscscan.com
